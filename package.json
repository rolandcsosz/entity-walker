{
    "name": "entity-walker",
    "version": "1.0.2",
    "description": "A type-safe, in-memory entity graph resolver for normalized data structures in TypeScript.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "test": "vitest ./tests/graph.test.ts ./tests/modification.test.ts",
        "test:watch": "vitest --watch",
        "lint": "eslint . --ext .ts,.tsx",
        "benchmark": "vitest ./tests/benchmark.test.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rolandcsosz/entity-walker.git"
    },
    "keywords": [
        "entity",
        "graph",
        "typescript",
        "relations",
        "foreign-key",
        "normalized-data"
    ],
    "author": "Roland Csősz",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.5.0",
        "eslint": "^8.50.0",
        "typescript": "^5.3.0",
        "vitest": "^4.0.18"
    }
}
