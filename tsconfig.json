{
    "compilerOptions": {
        "target": "ES2021",
        "module": "CommonJS",
        "esModuleInterop": true,
        "outDir": "dist",
        "rootDir": "src",
        "declaration": true,
        "emitDeclarationOnly": false,
        "strict": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "include": ["./src"],
    "exclude": ["node_modules", "dist"]
}
